datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   // "admin" | "tech" | "researcher" | "public"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Station {
  id           String        @id @default(uuid())
  code         String        @unique // ex: "STATION-001"
  name         String        // ex: "Station Météo Kinshasa"
  location     String        // ex: "Kinshasa / Gombe"
  latitude     Float?
  longitude    Float?
  status       String        @default("OFFLINE") // "ONLINE" | "DEGRADED" | "OFFLINE" | "MAINTENANCE"
  active       Boolean       @default(true)      // permet de désactiver la station
  apiKey       String        @unique // clé d'authentification propre au boîtier
  lastSeen     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  measures     Measure[]
  alerts       Alert[]
  maintenances Maintenance[]
}

model Measure {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  temperature    Float
  humidity       Float
  pressure       Float?
  rain           Int?
  alertActive    Boolean  @default(false)
  batteryVoltage Float?
  gsmSignal      Int?
  gsmOperator    String?
  temperatureBmp Float?
  temperatureDht Float?
  lbsLat         Float?
  lbsLon         Float?

  stationId      String?
  station        Station? @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String    @id @default(uuid())
  type        String    // "ENVIRONMENTAL" | "TECHNICAL"
  title       String    // ex: "Batterie Faible", "Vigilance Température"
  message     String
  severity    String    // "INFO" | "WARNING" | "CRITICAL"
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  stationId   String
  station     Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model Maintenance {
  id             String   @id @default(uuid())
  technicianName String
  description    String
  action         String
  result         String
  status         String   // "PENDING" | "RESOLVED"
  createdAt      DateTime @default(now())

  stationId      String
  station        Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id // ex: "temp_threshold_critical_high", "retention_days"
  value String
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // ex: "CREATE_USER", "UPDATE_THRESHOLD"
  details   String
  userEmail String?
  createdAt DateTime @default(now())
}
